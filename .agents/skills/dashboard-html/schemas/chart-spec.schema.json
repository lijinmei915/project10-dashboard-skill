{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/chart-spec.schema.json",
  "title": "Dashboard ChartSpec",
  "type": "object",
  "required": ["version", "chartType", "data", "appearance", "interactions", "refreshPolicy"],
  "properties": {
    "version": { "const": 1 },
    "chartType": { "$ref": "#/$defs/chartType" },
    "data": {
      "type": "object",
      "required": ["labels", "series"],
      "properties": {
        "labels": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 120 } },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "values": { "type": "array", "maxItems": 100, "items": { "type": "number" } }
            },
            "additionalProperties": false
          }
        },
        "thresholds": { "type": "array", "maxItems": 6, "items": { "type": "number" } },
        "combo": {
          "type": "object",
          "properties": {
            "dualAxis": { "type": "boolean" },
            "barUnit": { "type": "string", "maxLength": 12 },
            "lineUnit": { "type": "string", "maxLength": 12 }
          },
          "additionalProperties": false
        },
        "gauge": {
          "type": "object",
          "required": ["min", "max", "unit", "precision", "thresholds"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "type": "string", "maxLength": 12 },
            "precision": { "type": "integer", "minimum": 0, "maximum": 4 },
            "thresholds": { "type": "array", "maxItems": 6, "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        "bullet": {
          "type": "object",
          "required": ["min", "max", "unit", "precision", "ranges"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "type": "string", "maxLength": 12 },
            "precision": { "type": "integer", "minimum": 0, "maximum": 4 },
            "ranges": { "type": "array", "maxItems": 3, "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        "table": {
          "type": "object",
          "required": ["sort", "sortBy", "limit", "summary", "formats", "conditional"],
          "properties": {
            "sort": { "enum": ["none", "asc", "desc"] },
            "sortBy": { "type": "integer", "minimum": 0, "maximum": 11 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 20 },
            "summary": { "type": "boolean" },
            "formats": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["prefix", "suffix", "decimals"],
                "properties": {
                  "prefix": { "type": "string", "maxLength": 12 },
                  "suffix": { "type": "string", "maxLength": 12 },
                  "decimals": { "type": "integer", "minimum": 0, "maximum": 4 }
                },
                "additionalProperties": false
              }
            },
            "conditional": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dataBinding": {
      "type": "object",
      "required": ["datasetId", "dimensions", "metrics"],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "dimensions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "metrics": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "required": ["mode", "width", "height", "palette"],
      "properties": {
        "mode": { "enum": ["light", "dark"] },
        "width": { "type": "integer", "minimum": 240, "maximum": 1600 },
        "height": { "type": "integer", "minimum": 180, "maximum": 1000 },
        "palette": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
      },
      "additionalProperties": false
    },
    "interactions": {
      "type": "object",
      "required": ["legend", "tooltip", "zoom"],
      "properties": {
        "legend": {
          "type": "object",
          "required": ["visible", "interactive"],
          "properties": { "visible": { "type": "boolean" }, "interactive": { "type": "boolean" } },
          "additionalProperties": false
        },
        "tooltip": {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": false
        },
        "zoom": { "enum": ["none", "x", "y", "xy"] },
        "selection": {
          "type": "object",
          "required": ["enabled", "targetScope"],
          "properties": {
            "enabled": { "type": "boolean" },
            "targetScope": { "enum": ["component", "section", "page"] }
          },
          "additionalProperties": false
        },
        "drilldown": {
          "type": "object",
          "required": ["hierarchy", "targetScope"],
          "properties": {
            "hierarchy": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
            "targetScope": { "enum": ["component", "section", "page"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "refreshPolicy": {
      "type": "object",
      "required": ["mode", "pauseWhenHidden"],
      "properties": {
        "mode": { "enum": ["manual", "poll", "dataset-event"] },
        "intervalMs": { "type": "integer", "minimum": 5000, "maximum": 86400000 },
        "pauseWhenHidden": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "poll" } }, "required": ["mode"] },
          "then": { "required": ["intervalMs"] },
          "else": { "not": { "required": ["intervalMs"] } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "chartType": { "enum": ["line", "combo-bar-line", "time-series", "area", "bar", "grouped-bar", "stacked-bar", "percent-stacked-bar", "histogram", "horizontal-bar", "grouped-horizontal-bar", "stacked-horizontal-bar", "percent-stacked-horizontal-bar", "diverging-bar", "ranking-bar", "gantt", "sector-pie", "pie", "rose", "bullet", "gauge", "radar", "funnel", "data-table"] }
  }
}
