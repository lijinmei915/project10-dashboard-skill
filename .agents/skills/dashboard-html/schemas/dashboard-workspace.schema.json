{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/dashboard-workspace.schema.json",
  "title": "Dashboard Workspace",
  "description": "Portable contract shared by dashboard agents, Studio, and standalone exporters.",
  "type": "object",
  "required": ["version", "theme", "layout"],
  "properties": {
    "version": { "const": 2 },
    "theme": {
      "type": "object",
      "required": ["preset", "pageType", "language", "accent", "mode"],
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "pageType": { "enum": ["dashboard", "report"] },
        "language": { "enum": ["zh", "en"] },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "mode": { "enum": ["light", "dark"] },
        "sectionIcons": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "sectionSubtitles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cardOverrides": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "canvasOrder": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "layout", "items"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "grouped": { "type": "boolean" },
              "span": { "type": "integer", "enum": [4, 6, 8, 12] },
              "layout": { "type": ["string", "null"] },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "span"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "span": { "type": "integer", "minimum": 1, "maximum": 12 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["src"],
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "resources": {
      "type": "object",
      "description": "Optional portable resource metadata. Heavy indexes and libraries never belong here.",
      "properties": {
        "charts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "labels", "series"],
            "properties": {
              "type": { "enum": ["line", "area", "bar", "pie"] },
              "labels": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": ["name", "values"],
                  "properties": {
                    "name": { "type": "string" },
                    "values": { "type": "array", "maxItems": 100, "items": { "type": "number" } }
                  },
                  "additionalProperties": false
                }
              },
              "exportMode": { "enum": ["static", "interactive"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
