{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/dashboard-workspace.schema.json",
  "title": "Dashboard Workspace",
  "description": "Portable contract shared by dashboard agents, Studio, and standalone exporters.",
  "type": "object",
  "required": ["version", "theme", "layout"],
  "properties": {
    "version": { "const": 2 },
    "document": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "sampleDataLabel": { "type": "string", "maxLength": 100 },
        "controls": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/pageControl" }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["id", "title", "components"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "subtitle": { "type": "string", "maxLength": 200 },
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "required": ["id", "type", "title", "props"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                    "type": { "enum": ["summary", "kpi", "chart", "table", "list", "text"] },
                    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "subtitle": { "type": "string", "maxLength": 240 },
                    "dataRef": { "type": "string", "minLength": 1 },
                    "binding": { "$ref": "#/$defs/dataBinding" },
                    "props": { "type": "object" }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "type": { "const": "chart" } }, "required": ["type"] },
                      "then": {
                        "properties": {
                          "props": {
                            "type": "object",
                            "properties": { "chartType": { "$ref": "#/$defs/chartType" } }
                          }
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["preset", "pageType", "language", "accent", "mode"],
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "pageType": { "enum": ["dashboard", "report"] },
        "language": { "enum": ["zh", "en"] },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "mode": { "enum": ["light", "dark"] },
        "paletteVersion": { "type": "string", "enum": ["1.0.0", "1.2.0"] },
        "sectionIcons": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "sectionSubtitles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cardOverrides": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "canvasOrder": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "layout", "items"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "grouped": { "type": "boolean" },
              "span": { "type": "integer", "enum": [4, 6, 8, 12] },
              "layout": { "type": ["string", "null"] },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "span"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "span": { "type": "integer", "minimum": 1, "maximum": 12 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["src"],
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "resources": {
      "type": "object",
      "description": "Optional portable resource metadata. Heavy indexes and libraries never belong here.",
      "properties": {
        "datasets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["records", "portable"],
            "properties": {
              "portable": { "type": "boolean" },
              "records": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "charts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "labels", "series"],
            "properties": {
              "type": { "$ref": "#/$defs/chartType" },
              "labels": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": ["name", "values"],
                  "properties": {
                    "name": { "type": "string" },
                    "values": { "type": "array", "maxItems": 100, "items": { "type": "number" } }
                  },
                  "additionalProperties": false
                }
              },
              "exportMode": { "enum": ["static", "interactive"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "interactions": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "activeView": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "chartType": { "enum": ["line", "area", "bar", "horizontal-bar", "pie"] },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "numberFormat": {
      "type": "object",
      "properties": {
        "prefix": { "type": "string", "maxLength": 20 },
        "suffix": { "type": "string", "maxLength": 20 },
        "multiplier": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "maximumFractionDigits": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "aggregateBinding": {
      "type": "object",
      "required": ["kind", "operation"],
      "properties": {
        "kind": { "const": "aggregate" },
        "operation": { "enum": ["sum", "average", "min", "max", "count"] },
        "field": { "$ref": "#/$defs/identifier" },
        "format": { "$ref": "#/$defs/numberFormat" }
      },
      "additionalProperties": false
    },
    "seriesBinding": {
      "type": "object",
      "required": ["kind", "categoryField", "valueField", "operation"],
      "properties": {
        "kind": { "const": "series" },
        "categoryField": { "$ref": "#/$defs/identifier" },
        "valueField": { "$ref": "#/$defs/identifier" },
        "operation": { "enum": ["sum", "average", "min", "max", "count"] }
      },
      "additionalProperties": false
    },
    "rowsBinding": {
      "type": "object",
      "required": ["kind", "columns"],
      "properties": {
        "kind": { "const": "rows" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["field", "label"],
            "properties": {
              "field": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "additionalProperties": false
          }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "rankingBinding": {
      "type": "object",
      "required": ["kind", "labelField", "valueField", "operation"],
      "properties": {
        "kind": { "const": "ranking" },
        "labelField": { "$ref": "#/$defs/identifier" },
        "valueField": { "$ref": "#/$defs/identifier" },
        "operation": { "enum": ["sum", "average", "min", "max", "count"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "dataBinding": {
      "oneOf": [
        { "$ref": "#/$defs/aggregateBinding" },
        { "$ref": "#/$defs/seriesBinding" },
        { "$ref": "#/$defs/rowsBinding" },
        { "$ref": "#/$defs/rankingBinding" }
      ]
    },
    "filterOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "filterControl": {
      "type": "object",
      "required": ["id", "label", "control", "field", "options", "defaultValue"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "control": { "const": "select" },
        "field": { "$ref": "#/$defs/identifier" },
        "options": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/filterOption" } },
        "defaultValue": { "type": ["string", "number", "boolean"] }
      },
      "additionalProperties": false
    },
    "filterBar": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "filter-bar" },
        "props": {
          "type": "object",
          "required": ["controls", "targets"],
          "properties": {
            "controls": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/filterControl" } },
            "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "surface": { "enum": ["plain", "card"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "viewTabItem": {
      "type": "object",
      "required": ["id", "label", "sectionIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      },
      "additionalProperties": false
    },
    "viewTabs": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "view-tabs" },
        "props": {
          "type": "object",
          "required": ["items", "defaultValue"],
          "properties": {
            "items": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "$ref": "#/$defs/viewTabItem" } },
            "defaultValue": { "$ref": "#/$defs/identifier" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pageControl": { "oneOf": [{ "$ref": "#/$defs/filterBar" }, { "$ref": "#/$defs/viewTabs" }] }
  }
}
